# Frontend: leave blank for local Vite proxying or the single-container build.
# For Vercel, set this in Project Settings to the public Render backend URL.
VITE_API_BASE_URL=https://your-api.onrender.com

# Backend: comma-separated exact browser origins, with no trailing slash.
# Set this in Render to the public Vercel frontend URL.
FOODVERSE_CORS_ORIGINS=https://your-frontend.example.com

